<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.revolutclone</groupId>
    <artifactId>platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>common-messaging</artifactId>

  <name>Revolut Clone :: Platform :: Common Messaging</name>
  <description>
    Named for what it does, not the broker it currently uses. api/ holds ports with no Kafka
    on the classpath (EventPublisher, EventHandler, OutboxAppender); spring/ is the Kafka
    adapter. The outbox, the idempotent consumer and the error-handling config live alongside,
    reusable by every service.
  </description>

  <dependencies>
    <!-- Versions come from spring-boot-dependencies / spring-cloud-dependencies via the root
         parent; never pin them here. -->
    <dependency>
      <groupId>com.revolutclone</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- Same split as spring-boot-flyway: spring-kafka alone doesn't activate Boot's Kafka
           autoconfiguration (KafkaTemplate, consumer/producer factories) in 4.1. See
           docs/spring-boot-4-notes.md. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <!-- Task 07.4: DltAdminController (browse/replay DLT records over HTTP). Every current
           consumer of this module already has spring-boot-starter-web itself (confirmed by
           grepping every service pom - the only WebFlux service, api-gateway, does not depend
           on common-messaging), so this adds no new runtime capability to any of them - it just
           lets this module compile its own controller. DltAdminController is still guarded with
           @ConditionalOnClass so a future WebFlux-only consumer that excludes this transitive
           dependency never fails to start over it; see docs/spring-boot-4-notes.md's
           excludeName note for why an unconditional reference to a Servlet-only annotation type
           would be the wrong way to make that safe. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <!-- Task 07.4: DltDepthMetrics's Micrometer gauge. Version comes from the micrometer-bom
           spring-boot-dependencies imports, same as every other unpinned dependency here. -->
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <!-- Boot 4.1 split Flyway's autoconfiguration out of spring-boot-autoconfigure into its
           own module; flyway-core alone does not activate it. See
           docs/spring-boot-4-notes.md. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 12 split Postgres support out of flyway-core; without this, migrations fail
           at runtime with "no database support". See docs/spring-boot-4-notes.md. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The build gate only allows a direct call into the Kafka producer client under a
             path literally matching common-messaging/spring/ - matching the module's own
             deliverables tree in plans/phase-00-foundations.md, which draws api/ and spring/
             as the module's own top-level split rather than nested under src/main/java. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-spring-adapter-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/spring</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
