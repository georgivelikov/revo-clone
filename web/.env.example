# Copy to .env.local (gitignored) for local dev - see docker-compose.infra.yml /
# infra/keycloak/revolut-realm.json for where these values come from.
# Must be 127.0.0.1, not localhost: Keycloak runs with KC_HOSTNAME=http://127.0.0.1:8180
# (docker-compose.infra.yml), so that is the issuer in every token and in discovery. The page
# itself may be opened on either host; the gateway CORS allows both.
VITE_OIDC_AUTHORITY=http://127.0.0.1:8180/realms/revolut
VITE_OIDC_CLIENT_ID=revolut-web
VITE_API_BASE_URL=http://localhost:8080
# The WebSocket handshake only - the ticket endpoint goes through the gateway like everything
# else. WS origin-checking is separate from HTTP CORS (the gateway's alone), so this one
# connects to notification-service directly - see WS_ALLOWED_ORIGINS in that service's config.
VITE_NOTIFICATION_BASE_URL=http://localhost:8088
