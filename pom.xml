<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.revolutclone</groupId>
  <artifactId>revolut-clone</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Revolut Clone</name>
  <description>
    A Revolut-style neobank built to practise distributed-systems engineering: the
    double-entry ledger, event-driven choreography over Kafka, sagas with compensation,
    idempotency under retries, and a UX that makes eventual consistency visible.
  </description>

  <properties>
    <java.version>25</java.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Cloud 2025.1.3 is the floor for Boot 4.1 compatibility; see
           docs/spring-boot-4-notes.md for why 2025.1.0/.1 are excluded. -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>platform</module>
    <module>services</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- The JVM's default timezone name on this machine ("Europe/Kiev", the
                 pre-2022 alias) is rejected outright by postgres:17's bundled tzdata as an
                 invalid "TimeZone" startup parameter, failing every JDBC connection before
                 any test code runs. Forcing UTC for the test JVM sidesteps host-locale
                 dependence entirely rather than chasing tzdata aliases. -->
            <systemPropertyVariables combine.children="append">
              <user.timezone>UTC</user.timezone>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <!-- Same host-timezone problem as maven-surefire-plugin above, hit for real running
                 identity-service locally via `mvn spring-boot:run` (task 01.3): that goal forks
                 its own JVM, so the surefire fix above does not cover it. A packaged jar's own
                 JVM launch (Docker, later tasks) will need the same -Duser.timezone=UTC. -->
            <jvmArguments>-Duser.timezone=UTC</jvmArguments>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
