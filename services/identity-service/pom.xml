<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.revolutclone</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>identity-service</artifactId>

  <name>Revolut Clone :: Services :: Identity Service</name>
  <description>
    Owns everything about a person except credentials, which Keycloak owns. Registers users
    through IdentityProviderPort (never the Keycloak client directly), inserts user_profile
    and appends UserRegisteredV1 to the outbox in one local transaction, and exposes a
    reconcile endpoint for the one seam the outbox cannot cover - the external provider call
    that happens before that transaction starts.
  </description>

  <dependencies>
    <!-- Versions come from spring-boot-dependencies via the root parent; never pin them here. -->
    <dependency>
      <groupId>com.revolutclone</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.revolutclone</groupId>
      <artifactId>common-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.revolutclone</groupId>
      <artifactId>common-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.revolutclone</groupId>
      <artifactId>common-messaging</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <!-- Wraps the Keycloak Admin API call registration makes through IdentityProviderPort -
           plans/phase-07-resilience-and-scale.md's Circuit breakers table names this hop
           explicitly. Version comes from spring-cloud-dependencies, imported at the root;
           confirmed present at 5.0.3 in docs/spring-boot-4-notes.md. Same dependency
           payment-service uses for its payment -> fx breaker. -->
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- Boot 4.1 split Flyway's autoconfiguration out of spring-boot-autoconfigure; flyway-core
           alone does not activate it. See docs/spring-boot-4-notes.md. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 12 split Postgres support out of flyway-core. See docs/spring-boot-4-notes.md. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Boot 4.1 split @AutoConfigureMockMvc out of spring-boot-starter-test into its own
           module, alongside the spring-boot-persistence/flyway/kafka split already noted in
           docs/spring-boot-4-notes.md. See spring-boot-dependencies-4.1.1.pom for the artifact
           list; spring-boot-starter-test alone does not pull this in. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Only RegisterUserIntegrationTest needs a real Keycloak Testcontainer - matching this
           project's own IdentityProviderPortContractTest coordinate/version exactly (see
           platform/common-security/pom.xml and docs/spring-boot-4-notes.md). -->
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <version>4.3.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
